# -----------------------------------------------------------------------------
# Haven OS — environment variables
#
# Local: copy this to .env.local and fill in.
# Vercel: add each var under Settings → Environment Variables.
#         The "Where" column below tells you which Vercel environments
#         need which var (Production, Preview, Development).
# -----------------------------------------------------------------------------

# --- Supabase (required in all envs) ------------------------------------------
# Where: Production + Preview + Development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged key. Never exposed to the browser.
# Where: Production + Preview + Development
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL ------------------------------------------------------------------
# Absolute URL of the deployment, used for OAuth redirects.
# Where: Production only (set to the custom domain, e.g.
#        https://os.havenvacationrentals.com). Leave blank on Preview —
#        the app will fall back to VERCEL_URL automatically, so each
#        preview redirects to itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Claude (Haven Assistant + Managed Agents) --------------------------------
# Where: Production + Preview (server-only)
ANTHROPIC_API_KEY=

# --- Claude Managed Agents (beta) ---------------------------------------------
# Create once in the Claude Console (Managed Agents → Agents / Environments),
# then copy the IDs here. Used by /agents and /api/agents/*.
# Where: Production + Preview (server-only)
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=
