# -----------------------------------------------------------------------------
# Haven OS — environment variables
#
# Local: copy this to .env.local and fill in.
# Vercel: add each var under Settings → Environment Variables.
#         The "Where" column below tells you which Vercel environments
#         need which var (Production, Preview, Development).
# -----------------------------------------------------------------------------

# --- Supabase (required in all envs) ------------------------------------------
# Where: Production + Preview + Development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged key. Never exposed to the browser.
# Where: Production + Preview + Development
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL ------------------------------------------------------------------
# Canonical absolute URL of the deployment. Used for OAuth redirects AND
# for every absolute share link the app generates (sales pitches, HR
# surveys, careers postings, etc.). Without this set in Production, the
# app would fall back to the raw Vercel URL and users would be bounced
# off the custom domain after login.
#
# Where:
#   - Production only: set to the custom domain (e.g. https://www.havenvros.com)
#   - Preview: leave blank — each preview redirects to itself via VERCEL_URL
#   - Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Claude (Haven Assistant + Managed Agents) --------------------------------
# Where: Production + Preview (server-only)
ANTHROPIC_API_KEY=

# --- Claude Managed Agents (beta) ---------------------------------------------
# Create once in the Claude Console (Managed Agents → Agents / Environments),
# then copy the IDs here. Used by /agents and /api/agents/*.
# Where: Production + Preview (server-only)
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=

# --- Content Studio Managed Agent (optional) ----------------------------------
# Separate Claude Managed Agent that owns the Content Studio editor flow
# (left-pane chat + right-pane article edits). When unset, the Content
# Studio falls back to a local rule-based agent so the workspace still
# works end-to-end without external secrets.
#
# Recommended value (non-secret agent ID, created in Claude Console):
#   agent_011CaT8cFgxnMar5p8jGrr4q
# Console: https://platform.claude.com/workspaces/default/agents/agent_011CaT8cFgxnMar5p8jGrr4q?tab=config
#
# Where: Production + Preview (server-only)
CLAUDE_CONTENT_AGENT_ID=agent_011CaT8cFgxnMar5p8jGrr4q
CLAUDE_CONTENT_ENVIRONMENT_ID=

# --- WordPress draft integration (Content Studio) -----------------------------
# Used by the publish queue to create DRAFT posts on havenvacationrentals.com.
# Never publishes directly. If any of these are missing, publish jobs are
# recorded with status `credentials_missing` and the article stays in
# Haven OS — no draft is lost.
# Where: Production + Preview (server-only)
HAVEN_WP_URL=https://havenvacationrentals.com
HAVEN_WP_USER=
HAVEN_WP_APP_PASSWORD=
